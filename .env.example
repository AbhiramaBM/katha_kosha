NODE_ENV=development
PORT=5000

# Database (MySQL 8 with utf8mb4)
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=katha_kosha

# JWT Authentication
JWT_ACCESS_SECRET=katha_kosha_jwt_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=katha_kosha_jwt_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage (local | r2)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:5000

# Production only (Cloudflare R2 - S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Initial Seed Admin Credentials
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Chief Admin
